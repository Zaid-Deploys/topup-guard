# Bitrefill API Configuration
BITREFILL_API_KEY=your_bitrefill_api_key_here

# Recipient Phone (Optional default phone for mobile top-ups, format: +91 followed by 10 digits)
RECIPIENT_PHONE=+91XXXXXXXXXX

# Spending Guardrails (INR)
MAX_PER_PURCHASE_INR=200
MAX_PER_DAY_INR=500

# LLM Intent Extraction (Configure Gemini, Groq, or OpenRouter)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
